{
  "name": "opensimlab",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "Open Sim Lab — an open-source, browser-native clinical simulator.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "packageManager": "npm@11.12.0",
  "scripts": {
    "dev": "vite",
    "build": "npm run tokens && tsc -p tsconfig.json --noEmit && npm run og && vite build && npm run prerender && npm run gate",
    "preview": "vite preview",
    "tokens": "tsx scripts/build-tokens.ts",
    "prerender": "tsx --import ./scripts/register-css-stub.mjs scripts/prerender.ts",
    "og": "tsx --import ./scripts/register-css-stub.mjs scripts/build-og.ts",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false || tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && npm run lint:tokens",
    "lint:tokens": "tsx scripts/token-lint.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "budget": "tsx scripts/check-budgets.ts",
    "validate:specs": "openspec validate --specs --strict",
    "ci": "npm run validate:specs && npm run lint && npm run build && npm run test && npm run budget && npm run fonts",
    "fonts": "tsx scripts/check-fonts.ts",
    "gate": "tsx scripts/check-review-gate.ts",
    "release": "tsx scripts/check-review-gate.ts --release",
    "release:alpha": "tsx scripts/check-review-gate.ts --release --alpha",
    "preview:worker": "wrangler dev --local",
    "deploy": "npm run build && npm run release && wrangler deploy",
    "deploy:alpha": "npm run build && npm run release:alpha && wrangler deploy"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@fission-ai/openspec": "1.10.0",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "9.39.5",
    "jsdom": "30.0.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.11",
    "wrangler": "4.125.0"
  }
}
