{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensimlab.com/catalog/state-space-verification.schema.json",
  "title": "Open Sim Lab state-space-verification record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "scenarioId",
    "contentVersion",
    "cases"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "scenarioId": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "contentVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "cases": {
      "type": "array",
      "minItems": 17,
      "maxItems": 17,
      "allOf": [
        {
          "contains": {
            "properties": {
              "case": {
                "const": "expert"
              }
            },
            "required": [
              "case"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "case": {
                "const": "common-error"
              }
            },
            "required": [
              "case"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "case": {
                "const": "recovery"
              }
            },
            "required": [
              "case"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "case": {
                "const": "no-action"
              }
            },
            "required": [
              "case"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "case": {
                "const": "unsafe-or-refused"
              }
            },
            "required": [
              "case"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "case": {
                "const": "boundary-timing"
              }
            },
            "required": [
              "case"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "case": {
                "const": "supported-regions"
              }
            },
            "required": [
              "case"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "case": {
                "const": "minimum-seed"
              }
            },
            "required": [
              "case"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "case": {
                "const": "maximum-seed"
              }
            },
            "required": [
              "case"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "case": {
                "const": "guidance-levels"
              }
            },
            "required": [
              "case"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "case": {
                "const": "keyboard-only"
              }
            },
            "required": [
              "case"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "case": {
                "const": "screen-reader"
              }
            },
            "required": [
              "case"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "case": {
                "const": "reduced-motion"
              }
            },
            "required": [
              "case"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "case": {
                "const": "phone"
              }
            },
            "required": [
              "case"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "case": {
                "const": "offline"
              }
            },
            "required": [
              "case"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "case": {
                "const": "resume-and-replay"
              }
            },
            "required": [
              "case"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "case": {
                "const": "report-context"
              }
            },
            "required": [
              "case"
            ]
          }
        }
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case",
          "status",
          "evidence"
        ],
        "properties": {
          "case": {
            "enum": [
              "expert",
              "common-error",
              "recovery",
              "no-action",
              "unsafe-or-refused",
              "boundary-timing",
              "supported-regions",
              "minimum-seed",
              "maximum-seed",
              "guidance-levels",
              "keyboard-only",
              "screen-reader",
              "reduced-motion",
              "phone",
              "offline",
              "resume-and-replay",
              "report-context"
            ]
          },
          "status": {
            "const": "passed"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
