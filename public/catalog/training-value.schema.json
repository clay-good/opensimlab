{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensimlab.com/catalog/training-value.schema.json",
  "title": "Open Sim Lab training-value record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "scenarioId",
    "contentVersion",
    "fictionalTimeEvolvingState",
    "incompleteInformation",
    "learnerAction",
    "consequence",
    "reassessment",
    "causalDebrief",
    "staticOutputSubstitute",
    "evidence"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "scenarioId": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "contentVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "fictionalTimeEvolvingState": {
      "const": true
    },
    "incompleteInformation": {
      "const": true
    },
    "learnerAction": {
      "const": true
    },
    "consequence": {
      "const": true
    },
    "reassessment": {
      "const": true
    },
    "causalDebrief": {
      "const": true
    },
    "staticOutputSubstitute": {
      "const": false
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
